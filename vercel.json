{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/.well-known/appspecific/com.tesla.3p.public-key.pem",
      "headers": [
        { "key": "Content-Type", "value": "application/x-pem-file" }
      ]
    }
  ],
  "redirects": [
    { "source": "/items-sent", "destination": "https://omniexchange.org/items-sent", "permanent": true },
    { "source": "/video-contracts", "destination": "https://www.instituteofmatureimagination.org/video-contracts", "permanent": true },
    { "source": "/forge/four-ps", "destination": "/forge/five-ps", "permanent": true },
    { "source": "/forge/four-ps.html", "destination": "/forge/five-ps", "permanent": true }
  ],
  "rewrites": [
    { "source": "/education", "destination": "/education.html" },
    { "source": "/education-apply", "destination": "/education-apply.html" },
    { "source": "/forge", "destination": "/forge.html" },
    { "source": "/forge/mirror", "destination": "/forge/mirror.html" },
    { "source": "/forge/five-ps", "destination": "/forge/five-ps.html" },
    { "source": "/hive-king", "destination": "/hive-king.html" },
    { "source": "/philosophy", "destination": "/philosophy.html" },
    { "source": "/projects", "destination": "/projects.html" },
    { "source": "/yard-to-loop", "destination": "/yard-to-loop.html" },
    { "source": "/poop-to-loop", "destination": "/poop-to-loop.html" }
  ]
}
